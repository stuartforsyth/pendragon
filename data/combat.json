{
  "schema_version": 1,
  "_note": "Combat rules + human-foe bestiary parsed from the Pendragon Core Rulebook (Ch.2 & 7) and Gamemaster's Handbook ('Foes'). Data source for the Encounter Generator (see docs/encounter-generator-spec.md). Not yet wired into code.",

  "resolution": {
    "die": "1d20",
    "success": "roll <= skill value",
    "failure": "roll > skill value",
    "critical": "roll exactly equals the modified skill value (a skill of 20+ criticals on a 20)",
    "fumble": "natural 20, unless skill >= 20 (then no fumble)",
    "opposed": "both roll; the higher SUCCESSFUL roll wins and deals damage; equal successful rolls (or both critical) = tie and both strike; a successful-but-lower roll is a partial success and gains shield/parry protection",
    "damage_application": "winner's weapon damage minus defender Armor Points (+ shield) is applied to Hit Points; a single hit >= CON is a Major Wound; total damage >= SIZ triggers Knockdown; below Hit Points/4 = Unconscious; 0 = dead"
  },

  "critical_hit": {
    "melee_bonus": "on a critical hit, roll the weapon's damage dice PLUS the attacker's base Damage dice again (worked example: 5D6 -> 5D6+4D6)",
    "brawling": "a critical doubles Brawling Damage",
    "note": "transcribe exact wording from Core Rulebook Ch.7 'Winner's Outcome' at implementation"
  },

  "promotion": {
    "title_default": "Champion",
    "skill_bonus": 5,
    "hp_multiplier": 1.5,
    "damage_bonus_dice": 1,
    "armour_bonus": 2,
    "glory_multiplier": 3,
    "trait_bonus": { "Valorous": 3 }
  },

  "tiers": {
    "rabble": "Poorly trained and equipped; combat skills ~8-10.",
    "trained": "Guards, retainers, mercenary footmen; skills ~12-15.",
    "veteran": "Experienced, well-equipped warriors; skills ~15.",
    "elite": "Knights and champions; skills ~15-20."
  },

